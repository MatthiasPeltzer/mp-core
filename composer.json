{
  "name": "mpc/mp-core",
  "description": "Core TYPO3 CMS extension providing base templates, styling, container, content blocks and backend configurations",
  "type": "typo3-cms-extension",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Matthias Peltzer",
      "email": "mail@mpeltzer.de",
      "homepage": "https://www.mpeltzer.de/",
      "role": "Developer"
    }
  ],
  "homepage": "https://github.com/MatthiasPeltzer/mp-core",
  "require": {
    "php": ">=8.2",
    "typo3/cms-core": "^13.4 || ^14.0",
    "typo3/cms-extbase": "^13.4 || ^14.0",
    "typo3/cms-fluid": "^13.4 || ^14.0"
  },
  "suggest": {
    "b13/container": "^3.1",
    "friendsoftypo3/content-blocks": "^1.3 || ^2.0",
    "georgringer/news": "^14.0",
    "georgringer/numbered-pagination": "^2.1",
    "mpc/mpc-vidply": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Mpc\\MpCore\\": "Classes/"
    }
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "mp_core"
    }
  }
}
