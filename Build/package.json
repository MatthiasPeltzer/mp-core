{
	"name": "bootstrap5-vite",
	"version": "1.0.0",
	"description": "Bootstrap 5, Vite, PostCSS, Stylelint, ESLint",
	"type": "module",
	"scripts": {
		"build": "vite build --mode production",
		"dev": "vite build --mode development",
		"watch": "vite build --mode development --watch",
		"eslint": "eslint .",
		"eslint.fix": "eslint --fix .",
		"eslint.report": "eslint -f json -o reports/eslintreport.json Assets/**/*.js",
		"stylelint": "stylelint Assets/Scss/**/*.scss",
		"stylelint.fix": "stylelint Assets/Scss/**/*.scss --fix",
		"stylelint.report": "stylelint --config stylelint.config.js -f json -o reports/stylelintreport.json Assets/Scss/**/*.scss"
	},
	"author": "Matthias Peltzer",
	"license": "GPL-3.0-or-later",
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"bootstrap": "5.3.8",
		"jarallax": "^2.2.1",
		"swiper": "^12.0.3",
		"vue": "^3.5.25"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"@nabla/vite-plugin-eslint": "^2.0.6",
		"@vitejs/plugin-vue": "^6.0.2",
		"autoprefixer": "^10.4.22",
		"eslint": "^9.39.1",
		"globals": "^16.5.0",
		"postcss": "^8.5.6",
		"postcss-preset-env": "^10.4.0",
		"postcss-pxtorem": "^6.1.0",
		"sass": "1.94.2",
		"stylelint": "^16.26.1",
		"stylelint-config-recommended": "^17.0.0",
		"stylelint-config-recommended-scss": "^16.0.2",
		"stylelint-config-standard": "^39.0.1",
		"stylelint-order": "^7.0.0",
		"stylelint-scss": "^6.12.1",
		"vite": "^7.2.4",
		"vite-plugin-stylelint": "^6.0.2"
	}
}
