{
	"name": "bootstrap5-vite",
	"version": "1.0.0",
	"description": "Bootstrap 5, Vite, PostCSS, Stylelint, ESLint",
	"type": "module",
	"scripts": {
		"build": "npm run eslint && npm run stylelint && vite build --mode production",
		"dev": "npm run eslint && npm run stylelint && vite build --mode development",
		"watch": "vite build --mode development --watch",
		"lint": "npm run eslint && npm run stylelint",
		"eslint": "eslint .",
		"eslint.fix": "eslint --fix .",
		"eslint.report": "eslint -f json -o reports/eslintreport.json Assets/**/*.js",
		"stylelint": "stylelint Assets/Scss/**/*.scss",
		"stylelint.fix": "stylelint Assets/Scss/**/*.scss --fix",
		"stylelint.report": "stylelint --config stylelint.config.js -f json -o reports/stylelintreport.json Assets/Scss/**/*.scss"
	},
	"author": "Matthias Peltzer",
	"license": "GPL-3.0-or-later",
	"dependencies": {
		"@popperjs/core": "^2.11.8",
		"bootstrap": "5.3.8",
		"jarallax": "^2.2.1",
		"swiper": "^12.1.0",
		"vue": "^3.5.27"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitejs/plugin-vue": "^6.0.4",
		"autoprefixer": "^10.4.24",
		"eslint": "^10.0.0",
		"globals": "^17.3.0",
		"postcss": "^8.5.6",
		"postcss-preset-env": "^11.1.3",
		"postcss-pxtorem": "^6.1.0",
		"sass": "1.97.3",
		"stylelint": "^17.1.1",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-config-recommended-scss": "^17.0.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^7.0.1",
		"stylelint-scss": "^7.0.0",
		"vite": "^7.3.1"
	}
}
