{
	"name": "bootstrap6-vite",
	"version": "1.0.0",
	"description": "Bootstrap 6, Vite, PostCSS, Stylelint, ESLint",
	"type": "module",
	"scripts": {
		"typecheck": "vue-tsc --noEmit",
		"test:e2e:install": "playwright install chromium",
		"build": "npm run typecheck && npm run eslint && npm run stylelint && vite build --mode production && npm run check-size",
		"build:analyze": "node scripts/build-analyze.js",
		"dev": "npm run eslint && npm run stylelint && vite build --mode development",
		"watch": "vite build --mode development --watch",
		"check-size": "node scripts/check-bundle-size.js",
		"audit:bs6": "node scripts/bootstrap6-audit.mjs",
		"codemod:bs6-utilities": "node scripts/bootstrap6-responsive-utilities.mjs",
		"codemod:bs6-rename": "node scripts/bootstrap6-rename-sources.mjs",
		"lint": "npm run eslint && npm run stylelint",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"eslint": "eslint .",
		"eslint.fix": "eslint --fix .",
		"eslint.report": "eslint -f json -o reports/eslintreport.json \"Assets/**/*.{js,ts}\"",
		"stylelint": "stylelint Assets/Scss/**/*.scss",
		"stylelint.fix": "stylelint Assets/Scss/**/*.scss --fix",
		"stylelint.report": "stylelint --config stylelint.config.js -f json -o reports/stylelintreport.json Assets/Scss/**/*.scss"
	},
	"author": "Matthias Peltzer",
	"license": "GPL-2.0-or-later",
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"bootstrap": "6.0.0-alpha.1",
		"jarallax": "^3.1.0",
		"swiper": "^14.3.0",
		"vue": "^3.5.43"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@vitejs/plugin-vue": "^6.0.9",
		"@vitest/browser-playwright": "^5.0.3",
		"playwright": "^1.55.0",
		"typescript": "~6.0.0",
		"typescript-eslint": "^8.46.0",
		"vue-tsc": "^3.0.8",
		"autoprefixer": "^10.6.1",
		"eslint": "^10.12.0",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"jsdom": "^30.1.2",
		"postcss": "^8.5.29",
		"postcss-preset-env": "^11.6.1",
		"postcss-pxtorem": "^6.1.0",
		"sass": "1.105.1",
		"stylelint": "^17.16.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-config-recommended-scss": "^17.0.1",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^8.1.1",
		"stylelint-scss": "^7.3.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.3",
		"vue-eslint-parser": "^10.2.0"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true
	}
}
