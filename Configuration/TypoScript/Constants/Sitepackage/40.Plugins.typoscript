mpcSitepackage {
    plugins {
        news {
            templates = {$pluginsNewsTemplates}
            partials = {$pluginsNewsPartials}
            layouts = {$pluginsNewsLayouts}
        }

        indexedSearch {
            templates = {$pluginsIndexedSearchTemplates}
            partials = {$pluginsIndexedSearchPartials}
            layouts = {$pluginsIndexedSearchLayouts}
        }
    }
}
