##############
### CONFIG ###
##############
# The former config.* constants (admPanel, debug, no_cache, removeDefaultJS,
# headerComment, spamProtectEmailAddresses[_atSubst], absRefPrefix) now live in
# Site Settings (category MPCoreConfig) and are read via the {$config.*} flat
# constants those settings expose. Only the asset compression toggles remain
# here: they have no site-setting equivalent and serve as the {$config.compress*}
# / {$config.concatenate*} fallback in Setup/10.Config.typoscript (the primary
# value comes from site:settings.performance.*).
config {
  # cat=Default Templateset (MPC): advanced/150/140; type=boolean; label=Compress JavaScript
  compressJs = 0
  # cat=Default Templateset (MPC): advanced/150/150; type=boolean; label=Compress Css
  compressCss = 0
  # cat=Default Templateset (MPC): advanced/150/160; type=boolean; label=Concatenate JavaScript
  concatenateJs = 0
  # cat=Default Templateset (MPC): advanced/150/170; type=boolean; label=Concatenate Css
  concatenateCss = 0
}
