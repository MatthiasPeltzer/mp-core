lib {
  prefillUrl = TEXT
  prefillUrl {
    typolink {
      parameter {
        current = 1
      }

      forceAbsoluteUrl = 1
      returnLast = url
    }
  }

  sharePageUrl = TEXT
  sharePageUrl {
    typolink {
      parameter {
        current = 1
      }

      forceAbsoluteUrl = 1
      returnLast = url
    }
  }

  currentURL =< lib.sharePageUrl

  parseFunc {
    tags {
      a {
        typolink {
          wrap = <span class="icon" aria-hidden="true"></span>|
          ATagBeforeWrap = 1
        }
      }

      link {
        typolink {
          wrap = <span class="icon" aria-hidden="true"></span>|
          ATagBeforeWrap = 1
        }
      }
    }
  }

  parseFunc_RTE {
    tags {
      a {
        typolink {
          wrap = <span class="icon" aria-hidden="true"></span>|
          ATagBeforeWrap = 1
        }
      }
    }

    nonTypoTagStdWrap.encapsLines.nonWrappedTag >

    externalBlocks {
      pre {
        stdWrap {
          parseFunc {
            tags {
              a {
                typolink {
                  wrap = <span class="icon" aria-hidden="true"></span>|
                  ATagBeforeWrap = 1
                }
              }

              link {
                typolink {
                  wrap = <span class="icon" aria-hidden="true"></span>|
                  ATagBeforeWrap = 1
                }
              }
            }
          }
        }
      }
    }
  }
}