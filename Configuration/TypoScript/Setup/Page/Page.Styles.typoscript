page.headerData.2040 = FLUIDTEMPLATE
page.headerData.2040 {
  dataProcessing.10 < lib.contentProcessors.site
  # Resolves editor-managed web fonts (tx_mpcore_domain_model_webfontfamily +
  # FAL font files) into a validated @font-face / :root CSS string exposed as
  # {webFontsCss} in Styles.html.
  dataProcessing.20 = Mpc\MpCore\DataProcessing\WebFontProcessor
  file = EXT:mp_core/Resources/Private/Partials/Page/Styles.html
  # set extension name
  extbase {
    controllerExtensionName = mp_core
  }
}

