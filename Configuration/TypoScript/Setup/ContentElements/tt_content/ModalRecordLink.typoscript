# Render RTE / link browser modal record links as Bootstrap 6 Dialog triggers.
config {
  recordLinks {
    tx_mpcore_modal {
      forceLink = 1
      typolink {
        parameter {
          data = field:uid
          wrap = #modal-|
        }

        ATagParams.cObject = TEXT
        ATagParams.cObject {
          data = field:uid
          wrap = class="modal-link" data-bs-toggle="dialog" data-bs-target="#modal-|"
        }
      }
    }
  }
}
