@import 'EXT:mp_core/Configuration/Extensions/seo/Configuration/TypoScript/XmlSitemap/setup.typoscript'

#######################
#### SEO META TAGS ####
#######################

page {
  meta {
    # Description: page.description → page.abstract → site default
    description {
      cObject = COA
      cObject {
        10 = TEXT
        10 {
          data = page:description
          required = 1
        }

        20 = TEXT
        20 {
          if.isFalse.data = page:description
          data = page:abstract
          required = 1
        }

        30 = TEXT
        30 {
          if {
            isFalse.data = page:description
            and {
              isFalse.data = page:abstract
            }
          }
          data = site:settings.seo.meta.defaultDescription // site:websiteTitle
        }

        stdWrap {
          crop = 160|...|1
          stripHtml = 1
        }
      }
    }

    # Keywords from page
    keywords {
      cObject = TEXT
      cObject {
        data = page:keywords
        required = 1
      }
    }

    # Open Graph Tags
    og:title {
      attribute = property
      cObject = COA
      cObject {
        10 = TEXT
        10 {
          data = page:seo_title
          required = 1
        }

        20 = TEXT
        20 {
          if.isFalse.data = page:seo_title
          data = page:title
        }
      }
    }

    og:description {
      attribute = property
      cObject = COA
      cObject {
        10 = TEXT
        10 {
          data = page:description
          required = 1
        }

        20 = TEXT
        20 {
          if.isFalse.data = page:description
          data = page:abstract
          required = 1
        }

        30 = TEXT
        30 {
          if {
            isFalse.data = page:description
            and {
              isFalse.data = page:abstract
            }
          }
          data = site:settings.seo.meta.defaultDescription // site:websiteTitle
        }

        stdWrap {
          crop = 160|...|1
          stripHtml = 1
        }
      }
    }

    og:image {
      attribute = property
      cObject = COA
      cObject {
        # NOTE: When og_image is set in page properties, the TYPO3 core
        # MetaTagGenerator handles og:image with proper URL, dimensions, and alt.
        # This COA only provides fallback images for pages without og_image.

        # Priority 1: First media element from page (only when og_image is not set)
        10 = FILES
        10 {
          if.isFalse.field = og_image
          references {
            table = pages
            uid.data = page:uid
            fieldName = media
          }
          maxItems = 1
          renderObj = IMG_RESOURCE
          renderObj {
            file {
              import.data = file:current:uid
              treatIdAsReference = 1
              width = {$page.meta.og.image.width}c
              height = {$page.meta.og.image.height}c
            }
            stdWrap.dataWrap = {site:base}|
          }
          stdWrap.required = 1
        }

        # Priority 2: Content images OR default fallback
        # Only renders if og_image AND media are both empty
        20 = COA
        20 {
          if {
            isFalse.field = og_image
            and {
              isFalse.field = media
            }
          }

          # Try content element images first
          10 = CONTENT
          10 {
            table = tt_content
            select {
              pidInList.data = page:uid
              where = CType IN ('textmedia','textpic','image') AND deleted=0 AND hidden=0
              orderBy = sorting
              max = 1
            }
            renderObj = FILES
            renderObj {
              references {
                table = tt_content
                uid.field = uid
                fieldName = image
              }
              maxItems = 1
              renderObj = IMG_RESOURCE
              renderObj {
                file {
                  import.data = file:current:uid
                  treatIdAsReference = 1
                  width = {$page.meta.og.image.width}c
                  height = {$page.meta.og.image.height}c
                }
                stdWrap.dataWrap = {site:base}|
              }
            }
          }

          # Use ifEmpty to fall back to default image
          stdWrap {
            ifEmpty {
              cObject = IMG_RESOURCE
              cObject {
                file {
                  import.data = site:settings.seo.openGraph.defaultImage
                  import.ifEmpty = EXT:mp_core/Resources/Public/Images/og-default.jpg
                  width = {$page.meta.og.image.width}c
                  height = {$page.meta.og.image.height}c
                }
                stdWrap.dataWrap = {site:base}|
              }
            }
          }
        }
      }
    }


    og:type {
      attribute = property
      value = website
    }

    og:site_name {
      attribute = property
      data = site:websiteTitle
    }

    og:url {
      attribute = property
      cObject = TEXT
      cObject {
        typolink {
          parameter.data = page:uid
          returnLast = url
          forceAbsoluteUrl = 1
        }
      }
    }

    og:locale {
      attribute = property
      cObject = TEXT
      cObject {
        data = sitelanguage:locale:full
        replacement {
          10 {
            search = -
            replace = _
          }
        }
      }
    }

    # Twitter Card Tags
    twitter:card {
      value = summary_large_image
    }

    twitter:title {
      cObject = COA
      cObject {
        10 = TEXT
        10 {
          data = page:twitter_title
          required = 1
        }

        20 = TEXT
        20 {
          if.isFalse.data = page:twitter_title
          data = page:seo_title
          required = 1
        }

        30 = TEXT
        30 {
          if {
            isFalse.data = page:twitter_title
            and {
              isFalse.data = page:seo_title
            }
          }
          data = page:title
        }
      }
    }

    twitter:description {
      cObject = COA
      cObject {
        10 = TEXT
        10 {
          data = page:twitter_description
          required = 1
        }

        20 = TEXT
        20 {
          if.isFalse.data = page:twitter_description
          data = page:description
          required = 1
        }

        30 = TEXT
        30 {
          if {
            isFalse.data = page:twitter_description
            and {
              isFalse.data = page:description
            }
          }
          data = page:abstract
          required = 1
        }

        40 = TEXT
        40 {
          if {
            isFalse.data = page:twitter_description
            and {
              isFalse.data = page:description
              and {
                isFalse.data = page:abstract
              }
            }
          }
          data = site:settings.seo.meta.defaultDescription // site:websiteTitle
        }

        stdWrap {
          crop = 160|...|1
          stripHtml = 1
        }
      }
    }

    twitter:image {
      cObject = COA
      cObject {
        # NOTE: When twitter_image is set in page properties, the TYPO3 core
        # MetaTagGenerator handles twitter:image. This COA only provides fallbacks.

        # Priority 1: og_image field (when twitter_image is not set)
        10 = FILES
        10 {
          if.isFalse.field = twitter_image
          references {
            table = pages
            uid.data = page:uid
            fieldName = og_image
          }
          maxItems = 1
          renderObj = IMG_RESOURCE
          renderObj {
            file {
              import.data = file:current:uid
              treatIdAsReference = 1
              width = {$page.meta.og.image.width}c
              height = {$page.meta.og.image.height}c
            }
            stdWrap.dataWrap = {site:base}|
          }
          stdWrap.required = 1
        }

        # Priority 2: First media element
        20 = FILES
        20 {
          if {
            isFalse.field = twitter_image
            and {
              isFalse.field = og_image
            }
          }
          references {
            table = pages
            uid.data = page:uid
            fieldName = media
          }
          maxItems = 1
          renderObj = IMG_RESOURCE
          renderObj {
            file {
              import.data = file:current:uid
              treatIdAsReference = 1
              width = {$page.meta.og.image.width}c
              height = {$page.meta.og.image.height}c
            }
            stdWrap.dataWrap = {site:base}|
          }
          stdWrap.required = 1
        }

        # Priority 3: Content images OR default fallback
        # Only renders if twitter_image, og_image AND media are all empty
        30 = COA
        30 {
          if {
            isFalse.field = twitter_image
            and {
              isFalse.field = og_image
              and {
                isFalse.field = media
              }
            }
          }

          # Try content element images first
          10 = CONTENT
          10 {
            table = tt_content
            select {
              pidInList.data = page:uid
              where = CType IN ('textmedia','textpic','image') AND deleted=0 AND hidden=0
              orderBy = sorting
              max = 1
            }
            renderObj = FILES
            renderObj {
              references {
                table = tt_content
                uid.field = uid
                fieldName = image
              }
              maxItems = 1
              renderObj = IMG_RESOURCE
              renderObj {
                file {
                  import.data = file:current:uid
                  treatIdAsReference = 1
                  width = {$page.meta.og.image.width}c
                  height = {$page.meta.og.image.height}c
                }
                stdWrap.dataWrap = {site:base}|
              }
            }
          }

          # Use ifEmpty to fall back to default image
          stdWrap {
            ifEmpty {
              cObject = IMG_RESOURCE
              cObject {
                file {
                  import.data = site:settings.seo.openGraph.defaultImage
                  import.ifEmpty = EXT:mp_core/Resources/Public/Images/og-default.jpg
                  width = {$page.meta.og.image.width}c
                  height = {$page.meta.og.image.height}c
                }
                stdWrap.dataWrap = {site:base}|
              }
            }
          }
        }
      }
    }

    twitter:site {
      data = site:settings.seo.twitter.site
      if.isTrue.data = site:settings.seo.twitter.site
    }

    # OG image dimensions - only for fallback images
    # (core MetaTagGenerator handles dimensions when og_image is set)
    og:image:width {
      attribute = property
      value = {$page.meta.og.image.width}
      if.isFalse.field = og_image
    }

    og:image:height {
      attribute = property
      value = {$page.meta.og.image.height}
      if.isFalse.field = og_image
    }

    # og:image:alt - only for fallback images
    # (core MetaTagGenerator handles alt text when og_image is set)
    og:image:alt {
      attribute = property
      if.isFalse.field = og_image
      cObject = COA
      cObject {
        10 = FILES
        10 {
          references {
            table = pages
            uid.data = page:uid
            fieldName = media
          }
          maxItems = 1
          renderObj = TEXT
          renderObj {
            data = file:current:alternative // file:current:title
            htmlSpecialChars = 1
          }
          stdWrap.required = 1
        }

        # Fallback to page title when no file alt text is available
        stdWrap.ifEmpty.cObject = TEXT
        stdWrap.ifEmpty.cObject {
          data = page:title
          htmlSpecialChars = 1
        }
      }
    }

    # twitter:image:alt - only for fallback images
    # (core MetaTagGenerator handles alt text when twitter_image is set)
    twitter:image:alt {
      if.isFalse.field = twitter_image
      cObject = COA
      cObject {
        10 = FILES
        10 {
          references {
            table = pages
            uid.data = page:uid
            fieldName = og_image
          }
          maxItems = 1
          renderObj = TEXT
          renderObj {
            data = file:current:alternative // file:current:title
            htmlSpecialChars = 1
          }
          stdWrap.required = 1
        }

        20 = FILES
        20 {
          if.isFalse.field = og_image
          references {
            table = pages
            uid.data = page:uid
            fieldName = media
          }
          maxItems = 1
          renderObj = TEXT
          renderObj {
            data = file:current:alternative // file:current:title
            htmlSpecialChars = 1
          }
          stdWrap.required = 1
        }

        # Fallback to page title when no file alt text is available
        stdWrap.ifEmpty.cObject = TEXT
        stdWrap.ifEmpty.cObject {
          data = page:title
          htmlSpecialChars = 1
        }
      }
    }
  }
}

