<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
	<file source-language="en" datatype="plaintext" original="EXT:mp_core/Resources/Private/Language/locallang_form_bs6.xlf" date="2026-11-24T00:00:00Z" product-name="mp_core">
		<header/>
		<body>
			<trans-unit id="formEditor.elements.Date.editor.enableBootstrapDatepicker.label" resname="formEditor.elements.Date.editor.enableBootstrapDatepicker.label">
				<source>Bootstrap 6 date picker (popup calendar)</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.Date.editor.enableBootstrapDatepicker.description" resname="formEditor.elements.Date.editor.enableBootstrapDatepicker.description">
				<source>Replaces the native calendar with the Bootstrap 6 datepicker. Submits ISO dates (YYYY-MM-DD). Without JavaScript, a plain text field remains.</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.Date.editor.bootstrapDateMin.label" resname="formEditor.elements.Date.editor.bootstrapDateMin.label">
				<source>Earliest date (ISO)</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.Date.editor.bootstrapDateMin.description" resname="formEditor.elements.Date.editor.bootstrapDateMin.description">
				<source>Optional lower bound, e.g. 2026-01-01. Empty = no minimum.</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.Date.editor.bootstrapDateMax.label" resname="formEditor.elements.Date.editor.bootstrapDateMax.label">
				<source>Latest date (ISO)</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.Date.editor.bootstrapDateMax.description" resname="formEditor.elements.Date.editor.bootstrapDateMax.description">
				<source>Optional upper bound, e.g. 2026-12-31. Empty = no maximum.</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.label" resname="formEditor.elements.DateRange.label">
				<source>Date range</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.description" resname="formEditor.elements.DateRange.description">
				<source>Start and end date in one Bootstrap 6 range picker. Submits one value as comma-separated ISO dates (YYYY-MM-DD,YYYY-MM-DD).</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.editor.defaultValue.label" resname="formEditor.elements.DateRange.editor.defaultValue.label">
				<source>Default range (ISO)</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.editor.defaultValue.description" resname="formEditor.elements.DateRange.editor.defaultValue.description">
				<source>Optional preset, e.g. 2026-06-10,2026-06-18 (start comma end).</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.editor.bootstrapDisplayMonthsCount.label" resname="formEditor.elements.DateRange.editor.bootstrapDisplayMonthsCount.label">
				<source>Calendar months in popup</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.editor.bootstrapDisplayMonthsCount.description" resname="formEditor.elements.DateRange.editor.bootstrapDisplayMonthsCount.description">
				<source>Two months recommended: pick a start date, then an end date (same or next month). One month: calendar stays open after the first click—use month arrows if the end date is later.</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.editor.bootstrapDisplayMonthsCount.one" resname="formEditor.elements.DateRange.editor.bootstrapDisplayMonthsCount.one">
				<source>One month</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.editor.bootstrapDisplayMonthsCount.two" resname="formEditor.elements.DateRange.editor.bootstrapDisplayMonthsCount.two">
				<source>Two months</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateRange.validators.IsoDateRangeString.label" resname="formEditor.elements.DateRange.validators.IsoDateRangeString.label">
				<source>ISO date range format</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateFromTo.label" resname="formEditor.elements.DateFromTo.label">
				<source>Date from–to (two fields)</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateFromTo.description" resname="formEditor.elements.DateFromTo.description">
				<source>Accessible start and end with native date inputs (ISO). Works without JavaScript; with JavaScript, the end date cannot be before the start.</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateFromTo.editor.startLabel.label" resname="formEditor.elements.DateFromTo.editor.startLabel.label">
				<source>Start date label</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateFromTo.editor.endLabel.label" resname="formEditor.elements.DateFromTo.editor.endLabel.label">
				<source>End date label</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.DateFromTo.validators.IsoDateFromTo.label" resname="formEditor.elements.DateFromTo.validators.IsoDateFromTo.label">
				<source>ISO start/end dates</source>
			</trans-unit>
			<trans-unit id="form.bootstrap6.dateFromTo.startLabel" resname="form.bootstrap6.dateFromTo.startLabel">
				<source>From</source>
			</trans-unit>
			<trans-unit id="form.bootstrap6.dateFromTo.endLabel" resname="form.bootstrap6.dateFromTo.endLabel">
				<source>To</source>
			</trans-unit>
			<trans-unit id="form.bootstrap6.date.placeholder" resname="form.bootstrap6.date.placeholder">
				<source>DD/MM/YYYY</source>
			</trans-unit>
			<trans-unit id="form.bootstrap6.dateRange.placeholder" resname="form.bootstrap6.dateRange.placeholder">
				<source>DD/MM/YYYY – DD/MM/YYYY</source>
			</trans-unit>
			<trans-unit id="form.bootstrap6.dateRange.clear.label" resname="form.bootstrap6.dateRange.clear.label">
				<source>Clear date range</source>
			</trans-unit>
			<trans-unit id="form.bootstrap6.dateRange.rangeEndMessage" resname="form.bootstrap6.dateRange.rangeEndMessage">
				<source>Choose an end date.</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.MultiSelect.editor.useBootstrapCombobox.label" resname="formEditor.elements.MultiSelect.editor.useBootstrapCombobox.label">
				<source>Bootstrap 6 combobox (searchable multi select)</source>
			</trans-unit>
			<trans-unit id="formEditor.elements.MultiSelect.editor.useBootstrapCombobox.description" resname="formEditor.elements.MultiSelect.editor.useBootstrapCombobox.description">
				<source>Chip-style multi selection with a filterable menu. Values still submit through the native multi-select field.</source>
			</trans-unit>
			<trans-unit id="form.bootstrap6.combobox.placeholder" resname="form.bootstrap6.combobox.placeholder">
				<source>Filter or add options…</source>
			</trans-unit>
		</body>
	</file>
</xliff>